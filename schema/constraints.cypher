CREATE CONSTRAINT weakness_identity IF NOT EXISTS FOR (n:Weakness) REQUIRE n.weaknessId IS UNIQUE;
CREATE CONSTRAINT relation_proposal_id IF NOT EXISTS FOR (n:RelationProposal) REQUIRE n.proposalId IS UNIQUE;
CREATE CONSTRAINT relation_event_id IF NOT EXISTS FOR (n:RelationEvent) REQUIRE n.eventId IS UNIQUE;
CREATE CONSTRAINT payload_proposal_id IF NOT EXISTS FOR (n:PayloadProposal) REQUIRE n.proposalId IS UNIQUE;
CREATE CONSTRAINT payload_event_id IF NOT EXISTS FOR (n:PayloadEvent) REQUIRE n.eventId IS UNIQUE;
CREATE CONSTRAINT cre_id IF NOT EXISTS FOR (n:CRE) REQUIRE n.creId IS UNIQUE;
CREATE CONSTRAINT test_activity_id IF NOT EXISTS FOR (n:TestActivity) REQUIRE n.wstgId IS UNIQUE;
CREATE CONSTRAINT methodology_page_source IF NOT EXISTS FOR (n:MethodologyPage) REQUIRE n.sourcePage IS UNIQUE;
CREATE CONSTRAINT technology_name IF NOT EXISTS FOR (n:Technology) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT payload_family_key IF NOT EXISTS FOR (n:PayloadFamily) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT payload_id IF NOT EXISTS FOR (n:Payload) REQUIRE n.payloadId IS UNIQUE;
CREATE CONSTRAINT detection_signal_key IF NOT EXISTS FOR (n:DetectionSignal) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT scenario_id IF NOT EXISTS FOR (n:Scenario) REQUIRE n.scenarioId IS UNIQUE;
CREATE CONSTRAINT vulnerability_identity IF NOT EXISTS FOR (n:Vulnerability) REQUIRE n.vulnId IS UNIQUE;
CREATE CONSTRAINT evidence_identity IF NOT EXISTS FOR (n:Evidence) REQUIRE n.evidenceId IS UNIQUE;
CREATE CONSTRAINT product_name IF NOT EXISTS FOR (n:Product) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT component_identity IF NOT EXISTS FOR (n:Component) REQUIRE n.componentId IS UNIQUE;
CREATE CONSTRAINT version_range_identity IF NOT EXISTS FOR (n:VersionRange) REQUIRE n.rangeId IS UNIQUE;
CREATE CONSTRAINT fragment_id IF NOT EXISTS FOR (n:ScenarioFragment) REQUIRE n.fragmentId IS UNIQUE;
CREATE CONSTRAINT hypothesis_id IF NOT EXISTS FOR (n:DetectionHypothesis) REQUIRE n.hypothesisId IS UNIQUE;